{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build",
    "preview": "vite preview --config vite.demo.config.ts",
    "start": "node server/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/portal.browser.cjs",
    "catalog:pack": "node scripts/pack-catalog.mjs",
    "catalog:build": "node scripts/build-catalog.mjs && node scripts/repair-legacy.mjs && node scripts/pack-catalog.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^1.75.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "cheerio": "^1.2.0",
    "playwright": "^1.65.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0"
  }
}
